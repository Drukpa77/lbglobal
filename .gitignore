# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini

# certificates and keys (never commit)
*.pem
*.key
*.p12
*.pfx
*.jks
*.cer
*.crt
id_rsa
id_rsa.pub
*.pub

# cloud / OAuth JSON (often contain private keys or client secrets)
credentials.json
client_secret*.json
google-services.json
*serviceAccount*.json
*-firebase-adminsdk*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env and local secrets — real values stay out of git; template is tracked
.env
.env.*
!.env.example

# Cursor MCP config may store API keys / tokens
.cursor/mcp.json

# local databases (any path)
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# prisma default sqlite paths (redundant with *.db but explicit)
prisma/*.db
prisma/*.db-journal
prisma/*.sqlite
prisma/*.sqlite-journal

# test outputs
test-results/
playwright-report/

# user-uploaded files when stored locally (sensitive / large)
public/student-docs/
public/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local files
.idea/
.vscode/

# backups
backups/