DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-secure-random-token"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Must match your Blob store: "private" for private stores or "public" for public stores.
# Private stores route staff document opens through the app instead of direct CDN URLs.
BLOB_STORE_ACCESS="private"

# Enquiry email through Google Workspace SMTP.
CONTACT_INBOX_EMAIL="student@lbglobal.com.au"
GOOGLE_SMTP_HOST="smtp.gmail.com"
GOOGLE_SMTP_PORT="465"
GOOGLE_SMTP_SECURE="true"
GOOGLE_SMTP_USER="student@lbglobal.com.au"
# For Google Workspace SMTP, use a Google app password or SMTP relay credential.
GOOGLE_SMTP_PASSWORD=""
GOOGLE_WORKSPACE_FROM_EMAIL="L&B Global <student@lbglobal.com.au>"

# Transactional email for CRM-generated messages (Postmark).
# Used by invoices, contracts, application confirmations, staff notifications, and current staff system emails.
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_EMAIL="L&B Global <documents@lbglobal.com.au>"
POSTMARK_REPLY_TO_EMAIL="student@lbglobal.com.au"
POSTMARK_MESSAGE_STREAM="outbound"
POSTMARK_WEBHOOK_SECRET="replace-with-a-random-token"
