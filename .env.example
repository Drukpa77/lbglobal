DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-secure-random-token"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Must match your Blob store: "private" for private stores or "public" for public stores.
# Private stores route staff document opens through the app instead of direct CDN URLs.
BLOB_STORE_ACCESS="private"

# Contact form email (Resend — https://resend.com)
RESEND_API_KEY="re_..."
CONTACT_INBOX_EMAIL="student@lbglobal.com"
# After verifying your domain in Resend, e.g. "L&B Global <noreply@yourdomain.com>"
CONTACT_FROM_EMAIL="L&B Global <onboarding@resend.dev>"
