generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  INTERNAL_STAFF
  SUB_ADMIN
  ADMIN
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  DOCS_REQUESTED
  OFFER_RECEIVED
  VISA_GRANTED
  REJECTED
  ENROLLED
}

enum VisaStatus {
  NOT_STARTED
  DOCUMENTS_IN_PROGRESS
  APPLIED
  INTERVIEW_SCHEDULED
  ADDITIONAL_DOCS_REQUESTED
  APPROVED
  REJECTED
  EXPIRED
}

enum HomePostMediaType {
  NONE
  IMAGE
  VIDEO
}

enum PostMediaType {
  IMAGE
  VIDEO
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum DocumentCategory {
  PASSPORT
  TRANSCRIPT
  SOP
  OFFER_LETTER
  COE
  HEALTH_INSURANCE
  VISA
  FINANCIAL
  IDENTITY
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VisaCaseStatus {
  ACTIVE
  COMPLETED
  SUPERSEDED
  WITHDRAWN
}

enum WorkflowNotificationType {
  DOCUMENT_RETURNED
  DOCUMENT_REVERIFIED
  DOCUMENT_RETURN_DISPUTED
  DOCUMENT_RETURN_FOLLOW_UP
  DOCUMENT_REPLACEMENT_UPLOADED
  NEW_STUDENT_APPLICATION
  STUDENT_DELEGATED
  TASK_ASSIGNED
}

enum ContractStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum TemplateType {
  CONTRACT
  INVOICE
  FOLLOW_UP
  GENERAL
}

enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
}

enum EmailProvider {
  POSTMARK
  GOOGLE_WORKSPACE
  DEV
}

enum ConversationType {
  DIRECT
  TEAM
  STUDENT_THREAD
}

enum ActivityEntityType {
  STUDENT
  TASK
  DOCUMENT
  CONTRACT
  INVOICE
  MESSAGE
  ASSIGNMENT
  LEAD
  OPPORTUNITY
  QUOTE
  CASE
  CASE_STAGE
}

enum CaseStage {
  CONSULTATION_AND_DOCUMENTATION
  RESEARCH_PROPOSAL
  ENROLMENT_PROCESS
  CONDITIONAL_OFFER_LETTER
  UNCONDITIONAL_OFFER_LETTER
  TUITION_FEE_AND_OSHC_PAID
  COE_RECEIVED
  GTE_PROCESS
  VISA_DRAFT_PREPARATION
  VISA_LODGMENT
  VISA_GRANTED
  VISA_REFUSED
  AAT_CASE
  WITHDRAWN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NURTURE
  DISQUALIFIED
  CONVERTED
}

enum CrmAccountType {
  STUDENT
  PARENT
  PARTNER
  INSTITUTION
}

enum OpportunityStage {
  NEW
  QUOTE_SENT
  CLOSED_WON
  CLOSED_LOST
}

enum OpportunityForecastCategory {
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id                        String                    @id @default(cuid())
  name                      String?
  jobTitle                  String?
  email                     String                    @unique
  emailVerified             DateTime?
  password                  String?
  role                      Role                      @default(USER)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  studentProfile            StudentProfile?
  accounts                  Account[]
  sessions                  Session[]
  submissions               QuestionnaireSubmission[] @relation("StudentSubmissions")
  assignedReviews           QuestionnaireSubmission[] @relation("AssignedSubAdmin")
  homePosts                 HomePost[]
  managedTeamLinks          StaffTeamMembership[]     @relation("ManagerMemberships")
  internalTeamLinks         StaffTeamMembership[]     @relation("StaffMemberships")
  studentAssignments        StudentAssignment[]       @relation("AssignedStudentOwner")
  createdStudentAssignments StudentAssignment[]       @relation("StudentAssignmentCreator")
  assignedTasks             Task[]                    @relation("TaskAssignee")
  createdTasks              Task[]                    @relation("TaskCreator")
  completedTasks            Task[]                    @relation("TaskCompleter")
  uploadedDocuments         StudentDocument[]         @relation("DocumentUploader")
  createdConversations      Conversation[]            @relation("ConversationCreator")
  conversationMemberships   ConversationParticipant[]
  messagesSent              Message[]                 @relation("MessageSender")
  messageReadStates         MessageRead[]
  createdTemplates          EmailTemplate[]           @relation("TemplateCreator")
  createdContracts          Contract[]                @relation("ContractCreator")
  createdInvoices           Invoice[]                 @relation("InvoiceCreator")
  emailLogs                 OutboundEmailLog[]        @relation("EmailLogCreator")
  activitiesCreated         ActivityLog[]             @relation("ActivityCreator")
  activitiesTargeted        ActivityLog[]             @relation("ActivityTargetUser")
  assignedCases             Case[]                    @relation("AssignedCaseAgent")
  ownedLeads                Lead[]                    @relation("LeadOwner")
  submittedQuotes           Quote[]                   @relation("QuoteSubmitter")
  approvedQuotes            Quote[]                   @relation("QuoteApprover")
  rejectedQuotes            Quote[]                   @relation("QuoteRejecter")
  documentVerifications     StudentDocument[]         @relation("DocumentVerifier")
  documentReturns           StudentDocument[]         @relation("DocumentReturnedBy")
  workflowNotifications     WorkflowNotification[]    @relation("WorkflowNotificationRecipient")
  workflowNotificationsSent WorkflowNotification[]    @relation("WorkflowNotificationActor")
  deletedAt                 DateTime?
  deletedById               String?
  deletedBy                 User?                     @relation("DeletedClients", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedClients            User[]                    @relation("DeletedClients")

  @@index([deletedAt])
  @@index([deletedById])
  @@index([role])
  @@index([role, deletedAt])
}

model StudentProfile {
  id                      String                 @id @default(cuid())
  caseReference           String                 @unique
  userId                  String                 @unique
  dateOfBirth             DateTime?
  nationality             String?
  city                    String?
  currentAddress          String?                @db.Text
  phone                   String?
  emergencyContactName    String?
  emergencyContactEmail   String?
  emergencyContactPhone   String?
  emergencyContactAddress String?                @db.Text
  visaServiceType         String?
  otherServiceDescription String?                @db.Text
  currentEducationLevel   String?
  targetCourse            String?
  preferredIntake         String?
  englishTestType         String?
  englishTestScore        String?
  visaStatus              VisaStatus             @default(NOT_STARTED)
  caseStage               CaseStage              @default(CONSULTATION_AND_DOCUMENTATION)
  caseStageUpdatedAt      DateTime               @default(now())
  courseStartDate         DateTime?
  courseEndDate           DateTime?
  visaExpiryDate          DateTime?
  lastFollowUpDate        DateTime?
  nextFollowUpDate        DateTime?
  followUpNotes           String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents               StudentDocument[]
  contracts               Contract[]
  invoices                Invoice[]
  tasks                   Task[]
  conversations           Conversation[]         @relation("StudentConversation")
  assignments             StudentAssignment[]
  visaCases               VisaCase[]
  activities              ActivityLog[]          @relation("ActivityTargetStudent")
  workflowNotifications   WorkflowNotification[]
  leads                   Lead[]

  @@index([caseStage])
  @@index([nextFollowUpDate])
  @@index([visaExpiryDate])
}

model VisaCase {
  id                      String         @id @default(cuid())
  studentProfileId        String
  caseReference           String         @unique
  visaServiceType         String?
  otherServiceDescription String?        @db.Text
  caseStage               CaseStage      @default(CONSULTATION_AND_DOCUMENTATION)
  visaStatus              VisaStatus     @default(NOT_STARTED)
  status                  VisaCaseStatus @default(ACTIVE)
  courseStartDate         DateTime?
  courseEndDate           DateTime?
  visaExpiryDate          DateTime?
  startedAt               DateTime       @default(now())
  completedAt             DateTime?
  notes                   String?        @db.Text
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  studentProfile          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId, status])
  @@index([startedAt])
}

model QuestionnaireTemplate {
  id          String                    @id @default(cuid())
  title       String
  description String?
  isActive    Boolean                   @default(true)
  questions   Json
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  submissions QuestionnaireSubmission[]
}

model QuestionnaireSubmission {
  id               String                @id @default(cuid())
  studentId        String
  templateId       String
  assignedToId     String?
  sourceCity       String?
  sourceCountry    String?
  intendedCourse   String?
  intendedIntake   String?
  answers          Json
  status           SubmissionStatus      @default(SUBMITTED)
  submittedAt      DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  student          User                  @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  template         QuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignedSubAdmin User?                 @relation("AssignedSubAdmin", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([assignedToId, submittedAt])
  @@index([studentId, submittedAt])
  @@index([status, submittedAt])
  @@index([assignedToId, status])
  @@index([submittedAt])
}

model HomePost {
  id                   String            @id @default(cuid())
  title                String
  slug                 String?           @unique
  content              String            @db.Text
  contentHtml          String            @default("") @db.LongText
  mediaType            HomePostMediaType @default(NONE)
  mediaUrl             String?
  featuredThumbnail    String?
  featuredThumbnailAlt String?
  isPublished          Boolean           @default(false)
  publishDate          DateTime?
  metaTitle            String?
  metaDescription      String?           @db.Text
  metaKeywords         String?           @db.Text
  focusKeyword         String?
  ogImage              String?
  authorId             String
  authorNameSnapshot   String            @default("Unknown")
  authorEmailSnapshot  String            @default("")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  author               User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  galleryMedia         PostMedia[]

  @@index([isPublished, publishDate])
}

model PostMedia {
  id        String        @id @default(cuid())
  postId    String
  url       String
  mediaType PostMediaType
  altText   String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      HomePost      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model StaffTeamMembership {
  id              String   @id @default(cuid())
  managerId       String
  internalStaffId String
  createdAt       DateTime @default(now())
  manager         User     @relation("ManagerMemberships", fields: [managerId], references: [id], onDelete: Cascade)
  internalStaff   User     @relation("StaffMemberships", fields: [internalStaffId], references: [id], onDelete: Cascade)

  @@unique([managerId, internalStaffId])
  @@index([managerId])
  @@index([internalStaffId])
}

model StudentAssignment {
  id               String         @id @default(cuid())
  studentProfileId String
  assignedToId     String
  assignedById     String
  notes            String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  endedAt          DateTime?
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assignedTo       User           @relation("AssignedStudentOwner", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedBy       User           @relation("StudentAssignmentCreator", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, assignedToId])
  @@index([assignedToId, isActive])
  @@index([studentProfileId, isActive])
}

model Task {
  id               String         @id @default(cuid())
  title            String
  description      String?
  priority         TaskPriority   @default(MEDIUM)
  status           TaskStatus     @default(TODO)
  dueDate          DateTime?
  studentProfileId String
  assigneeId       String
  assignerId       String
  completedById    String?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assignee         User           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigner         User           @relation("TaskCreator", fields: [assignerId], references: [id], onDelete: Cascade)
  completedBy      User?          @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([completedById])
  @@index([studentProfileId, status])
  @@index([assigneeId, status])
  @@index([status, dueDate])
}

model StudentDocument {
  id                    String                     @id @default(cuid())
  studentProfileId      String
  uploadedById          String
  verifiedById          String?
  returnedById          String?
  replacedDocumentId    String?
  category              DocumentCategory           @default(OTHER)
  title                 String
  originalFileName      String
  storagePath           String
  mimeType              String
  sizeBytes             Int
  verificationStatus    DocumentVerificationStatus @default(PENDING)
  notes                 String?
  verifiedAt            DateTime?
  returnedAt            DateTime?
  returnedNote          String?
  returnResolvedAt      DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  studentProfile        StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  uploadedBy            User                       @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  verifiedBy            User?                      @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  returnedBy            User?                      @relation("DocumentReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  replacedDocument      StudentDocument?           @relation("DocumentReplacementChain", fields: [replacedDocumentId], references: [id], onDelete: SetNull)
  replacementDocuments  StudentDocument[]          @relation("DocumentReplacementChain")
  workflowNotifications WorkflowNotification[]

  @@index([replacedDocumentId])
  @@index([studentProfileId, verificationStatus])
  @@index([verificationStatus, createdAt])
}

model EmailTemplate {
  id           String       @id @default(cuid())
  key          String       @unique
  name         String
  type         TemplateType @default(GENERAL)
  subject      String
  htmlBody     String       @db.LongText
  placeholders Json?
  isActive     Boolean      @default(true)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    User         @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)
  contracts    Contract[]
  invoices     Invoice[]
}

model Contract {
  id               String         @id @default(cuid())
  studentProfileId String
  templateId       String?
  createdById      String
  title            String
  subject          String
  recipientEmail   String
  htmlSnapshot     String         @db.LongText
  contractNumber   String?        @unique
  contractDate     String?
  applicantTitle   String?
  applicantName    String?
  applicantCid     String?
  organizationName String?
  hasDependent     Boolean        @default(false)
  dependentName    String?
  witnessName      String?
  witnessCid       String?
  witnessContact   String?
  status           ContractStatus @default(DRAFT)
  sentAt           DateTime?
  acceptedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  template         EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy        User           @relation("ContractCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([studentProfileId, status])
}

model Invoice {
  id               String            @id @default(cuid())
  studentProfileId String
  templateId       String?
  createdById      String
  invoiceNumber    String            @unique
  title            String
  subject          String
  recipientEmail   String
  currency         String            @default("AUD")
  subtotal         Float             @default(0)
  discountAmount   Float             @default(0)
  taxRate          Float             @default(0)
  taxAmount        Float             @default(0)
  shippingAmount   Float             @default(0)
  totalAmount      Float             @default(0)
  dueDate          DateTime?
  paymentTerms     String?
  remarks          String?           @db.Text
  companyName      String?
  companyAddress   String?           @db.Text
  companyContact   String?           @db.Text
  companyLogoUrl   String?
  billToName       String?
  billToCompany    String?
  billToAddress    String?           @db.Text
  billToPhone      String?
  billToEmail      String?
  shipToName       String?
  shipToCompany    String?
  shipToAddress    String?           @db.Text
  shipToPhone      String?
  shipToEmail      String?
  status           InvoiceStatus     @default(DRAFT)
  htmlSnapshot     String            @db.Text
  sentAt           DateTime?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  template         EmailTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy        User              @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  lineItems        InvoiceLineItem[]
}

model CompanySettings {
  id              String   @id @default(cuid())
  singleton       Boolean  @unique @default(true)
  companyName     String   @default("L&B Global")
  legalName       String?
  abn             String?
  addressLine     String?  @db.Text
  contactDetails  String?  @db.Text
  bankDetails     String?  @db.Text
  logoUrl         String?
  defaultCurrency String   @default("AUD")
  defaultTaxRate  Float    @default(10)
  defaultTaxLabel String   @default("GST")
  paymentTerms    String?
  paymentRemarks  String?  @db.Text
  invoicePrefix   String   @default("INV-")
  invoiceFooter   String?  @db.Text
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String   @db.Text
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  amount      Float    @default(0)
  taxable     Boolean  @default(true)
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model OutboundEmailLog {
  id                  String         @id @default(cuid())
  createdById         String
  toEmail             String
  subject             String
  htmlBody            String         @db.LongText
  templateKey         String?
  relatedContractId   String?
  relatedInvoiceId    String?
  status              EmailLogStatus @default(QUEUED)
  provider            EmailProvider  @default(POSTMARK)
  providerMessageId   String?
  errorMessage        String?        @db.Text
  deliveredAt         DateTime?
  bouncedAt           DateTime?
  lastProviderEvent   String?
  lastProviderEventAt DateTime?
  providerEventData   Json?
  createdAt           DateTime       @default(now())
  sentAt              DateTime?
  createdBy           User           @relation("EmailLogCreator", fields: [createdById], references: [id], onDelete: Cascade)
}

model Conversation {
  id               String                    @id @default(cuid())
  type             ConversationType          @default(TEAM)
  title            String?
  studentProfileId String?
  createdById      String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  createdBy        User                      @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile?           @relation("StudentConversation", fields: [studentProfileId], references: [id], onDelete: SetNull)
  participants     ConversationParticipant[]
  messages         Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reads          MessageRead[]
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model ActivityLog {
  id                     String             @id @default(cuid())
  actorId                String
  targetUserId           String?
  targetStudentProfileId String?
  entityType             ActivityEntityType
  entityId               String
  action                 String
  metadata               Json?
  createdAt              DateTime           @default(now())
  actor                  User               @relation("ActivityCreator", fields: [actorId], references: [id], onDelete: Cascade)
  targetUser             User?              @relation("ActivityTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetStudentProfile   StudentProfile?    @relation("ActivityTargetStudent", fields: [targetStudentProfileId], references: [id], onDelete: SetNull)
}

model WorkflowNotification {
  id               String                   @id @default(cuid())
  recipientId      String
  actorId          String?
  studentProfileId String
  documentId       String?
  type             WorkflowNotificationType
  title            String
  message          String
  note             String?
  link             String
  actionRequired   Boolean                  @default(true)
  metadata         Json?
  readAt           DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  recipient        User                     @relation("WorkflowNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor            User?                    @relation("WorkflowNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  studentProfile   StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  document         StudentDocument?         @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, actionRequired])
  @@index([studentProfileId, createdAt])
  @@index([documentId, type])
}

model CrmAccount {
  id            String         @id @default(cuid())
  name          String
  accountType   CrmAccountType @default(STUDENT)
  phone         String?
  email         String?
  website       String?
  source        String?
  tag           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leads         Lead[]
  opportunities Opportunity[]
  cases         Case[]
}

model Lead {
  id                     String         @id @default(cuid())
  name                   String
  phone                  String?
  email                  String?
  source                 String?
  status                 LeadStatus     @default(NEW)
  ownerId                String?
  assignedAt             DateTime?
  leadScore              Int            @default(0)
  qualificationNotes     String?
  qualificationReason    String?
  disqualificationReason String?
  nextFollowUpAt         DateTime?
  lastContactAt          DateTime?
  firstResponseAt        DateTime?
  sourceChannel          String?
  sourceDetail           String?
  campaignName           String?
  parentName             String?
  parentPhone            String?
  parentEmail            String?
  convertedAt            DateTime?
  studentProfileId       String
  accountId              String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  studentProfile         StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  account                CrmAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner                  User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  opportunity            Opportunity?

  @@index([studentProfileId, createdAt])
  @@index([ownerId, status])
  @@index([nextFollowUpAt, status])
  @@index([accountId])
}

model Opportunity {
  id                String                      @id @default(cuid())
  leadId            String                      @unique
  accountId         String
  name              String                      @default("Opportunity")
  amount            Float                       @default(0)
  probability       Int                         @default(10)
  expectedCloseDate DateTime?
  forecastCategory  OpportunityForecastCategory @default(PIPELINE)
  stage             OpportunityStage            @default(NEW)
  closedAt          DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  lead              Lead                        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  account           CrmAccount                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  quotes            Quote[]
  case              Case?

  @@index([accountId])
}

model Quote {
  id            String      @id @default(cuid())
  opportunityId String
  amount        Float       @default(0)
  description   String?
  status        QuoteStatus @default(DRAFT)
  approvalNotes String?
  submittedById String?
  approvedById  String?
  rejectedById  String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  decisionedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  submittedBy   User?       @relation("QuoteSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy    User?       @relation("QuoteApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy    User?       @relation("QuoteRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)

  @@index([opportunityId, createdAt])
  @@index([submittedById])
  @@index([approvedById])
  @@index([rejectedById])
}

model Case {
  id              String      @id @default(cuid())
  opportunityId   String      @unique
  accountId       String
  title           String
  description     String?
  status          CaseStatus  @default(OPEN)
  assignedAgentId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  account         CrmAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedAgent   User?       @relation("AssignedCaseAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([assignedAgentId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
